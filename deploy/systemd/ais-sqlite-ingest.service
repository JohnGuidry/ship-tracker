[Unit]
Description=AIS SQLite ingest (NMEA -> SQLite)
After=ais-listener.service
Requires=ais-listener.service

[Service]
Type=simple
User=john
ExecStart=/usr/bin/python3 /home/john/rtl-ais/ais_sqlite_ingest.py tail
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
