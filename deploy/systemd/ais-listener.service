[Unit]
Description=AIS UDP listener (NMEA capture to log)
After=network.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/john/rtl-ais/scripts/ais_udp_listener.py /home/john/ais_capture.log
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
